+
+    /// Loads and resizes the ground-truth depth map (if any) to exactly match
+    /// [`Self::dimensions`], so it lines up pixel-for-pixel with the training image and
+    /// the rendered depth channel. Values are in meters; a source pixel of 0 (the usual
+    /// "no data" sentinel for LiDAR/ARKit depth) stays 0 and should be treated as invalid
+    /// by the caller (see the depth loss in brush-train).
+    ///
+    /// Expects a 16-bit grayscale PNG with values in millimeters (matches the raw
+    /// LiDAR/ARKit depth convention used by the datasets this was built for). Nearest-
+    /// neighbor resizing is used deliberately, to avoid blending depth across real
+    /// discontinuities (object silhouettes) the way a smooth filter would.
+    pub async fn load_depth(&self) -> image::ImageResult<Option<Vec<f32>>> {
+        let Some(depth_path) = &self.depth_path else {
+            return Ok(None);
+        };
+        let mut depth_bytes = vec![];
+        self.vfs
+            .reader_at_path(depth_path)
+            .await?
+            .read_to_end(&mut depth_bytes)
+            .await?;
+        let depth_img = image::load_from_memory(&depth_bytes)?;
+        let target = self.dimensions();
+        let resized =
+            depth_img.resize_exact(target.x, target.y, image::imageops::FilterType::Nearest);
+        let depth_mm = resized.to_luma16();
+        Ok(Some(
+            depth_mm.into_raw().into_iter().map(|v| v as f32 / 1000.0).collect(),
+        ))
+    }
+
     pub fn aspect_ratio(&self) -> f32 {
         let dim = self.dimensions();
         dim.x as f32 / dim.y as f32
@@ -273,6 +310,10 @@ pub struct SceneBatch<B: Backend> {
