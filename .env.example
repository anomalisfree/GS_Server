# GS Server environment variables
# Copy this to .env and fill in values, or set them in the systemd service

# ── Server ────────────────────────────────────────────────────────────────────
GS_HOST=0.0.0.0
GS_PORT=8080
GS_MAX_UPLOAD_GB=50.0

# ── Paths ─────────────────────────────────────────────────────────────────────
# Linux (GCP VM or Docker):
GS_JOBS_DIR=/data/jobs
GS_UPLOADS_DIR=/data/uploads
GS_MODELS_DIR=/data/models
GS_COLMAP_EXE=/usr/bin/colmap
GS_BRUSH_EXE=/home/YOUR_USER/gs_server/brush/target/release/brush

# Windows (local dev):
# GS_COLMAP_EXE=C:\path\to\gs_server\colmap\bin\colmap.exe
# GS_BRUSH_EXE=C:\path\to\gs_server\brush\target\release\brush.exe

# ── COLMAP ───────────────────────────────────────────────────────────────────
COLMAP_USE_GPU=true
COLMAP_CAMERA_MODEL=OPENCV
COLMAP_MAX_IMAGE_SIZE=3200

# ── Brush training ───────────────────────────────────────────────────────────
BRUSH_TOTAL_STEPS=30000
BRUSH_MAX_RESOLUTION=1920
BRUSH_EVAL_EVERY=1000
BRUSH_EXPORT_EVERY=2500

# ── Masking ──────────────────────────────────────────────────────────────────
MASKING_ENABLED=true
MASKING_REMOVE_CLASSES=bicycle,bus,car,cat,dog,motorbike,person
